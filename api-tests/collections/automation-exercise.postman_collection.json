    {
      "name": "PUT To All Brands List",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Status code\r",
              "pm.test(\"Status code é 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Resposta é JSON válido\r",
              "pm.test(\"Resposta é um JSON válido\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "// 3. Estrutura da resposta\r",
              "pm.test(\"Resposta contém a chave 'products'\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"products\");\r",
              "    pm.expect(jsonData.products).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "// 4. Lista não vazia (esperado, já que \"tshirt\" deve ter resultado)\r",
              "pm.test(\"Lista de produtos retornados não está vazia\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.products.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "// 5. Todos os produtos retornados são relevantes à busca\r",
              "pm.test(\"Produtos retornados contêm o termo buscado no nome\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    const termoBuscado = pm.request.body.urlencoded.get(\"search_product\").toLowerCase();\r",
              "    \r",
              "    jsonData.products.forEach(function (product) {\r",
              "        pm.expect(product.name.toLowerCase()).to.include(termoBuscado);\r",
              "    });\r",
              "});\r",
              "\r",
              "// 6. Schema de cada produto retornado\r",
              "pm.test(\"Cada produto contém os campos obrigatórios\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    jsonData.products.forEach(function (product) {\r",
              "        pm.expect(product).to.have.property(\"id\");\r",
              "        pm.expect(product).to.have.property(\"name\");\r",
              "        pm.expect(product).to.have.property(\"price\");\r",
              "        pm.expect(product).to.have.property(\"brand\");\r",
              "        pm.expect(product).to.have.property(\"category\");\r",
              "    });\r",
              "});\r",
              "\r",
              "// 7. Tempo de resposta\r",
              "pm.test(\"Tempo de resposta é aceitável (< 2000ms)\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
